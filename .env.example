# Copy to .env for local runs. NEVER commit the real .env.

# SQLite for quick local work; Postgres in docker compose / on the server.
DATABASE_URL=sqlite:///./fxlab.db

# Secret the counterparty service sends with every ack (protects POST /api/posttrade/acks).
# Nobody types it: both services read it from the environment. Empty = not checked (dev only).
API_KEY=

# Where the gateway sends Trade Capture Reports, and where counterparties send acks back.
COUNTERPARTY_URL=http://localhost:8001
GATEWAY_ACK_URL=http://localhost:8000/api/posttrade/acks

# Monitoring thresholds
ACK_SLA_SECONDS=30
LARGE_NOTIONAL_USD=5000000
OFF_MARKET_BPS=10
